{
  "name": "bendy",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:rules": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/test/firestore-rules.test.mjs",
    "test:crowd": "VITE_FIRESTORE_EMULATOR=127.0.0.1:8080 vite build --outDir dist-emu && vite preview --port 4180 --outDir dist-emu & sleep 6 && node scripts/test/crowd-reports.e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "lucide-react": "^0.263.1",
    "mapbox-gl": "^2.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/mapbox-gl": "^2.7.13",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vercel/node": "^5.6.16",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "playwright": "^1.62.1",
    "postcss": "^8.4.27",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
